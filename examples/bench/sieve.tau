// Arrays, loops and bounds checks.
fn main() {
    let n = 5000000
    let mut sieve = Vec<bool>.new()
    for i in 0..n + 1 { sieve.push(true) }
    sieve[0] = false
    sieve[1] = false
    let mut i = 2
    while i * i <= n {
        if sieve[i] {
            let mut j = i * i
            while j <= n {
                sieve[j] = false
                j += i
            }
        }
        i += 1
    }
    let mut count = 0
    for k in 0..n + 1 { if sieve[k] { count += 1 } }
    print("{count} primes up to {n}")
}
