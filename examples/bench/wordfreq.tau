// Strings, maps and sorting-free top-N.
use std.map.Map

fn main() {
    let mut counts = Map<String, usize>.new()
    let mut state = 12345
    for i in 0..3000000 {
        state = (state * 1103515245 + 12345) % 2147483648
        let k = state % 5000
        counts["w{k}".uppercase()] += 1
    }
    for (w, n) in counts.top(5) { print("{w}: {n}") }
}
