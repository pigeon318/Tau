// Bubble sort on pseudo-random data from a linear congruential generator.

fn next(state: i64) -> i64 {
    (state * 1103515245 + 12345) % 2147483648
}

fn bubble_sort(v: mut [i64]) {
    let n = v.len
    for i in 0..n {
        for j in 0..n - 1 - i {
            if v[j] > v[j + 1] {
                let t = v[j]
                v[j] = v[j + 1]
                v[j + 1] = t
            }
        }
    }
}

fn main() {
    let mut state = 42
    let mut data = Vec<i64>.new()
    for i in 0..20 {
        state = next(state)
        data.push(state % 100)
    }
    print(data)
    bubble_sort(mut data)
    print(data)
}
