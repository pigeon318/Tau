// Gravitational n-body simulation: operator overloading, mutable borrows,
// field and index assignment through a `mut` parameter.

const G: f64 = 6.674e-11

struct Vec3 { x: f64, y: f64, z: f64 }

impl Add for Vec3 {
    fn add(self, o: Vec3) -> Vec3 { Vec3(self.x + o.x, self.y + o.y, self.z + o.z) }
}

impl Sub for Vec3 {
    fn sub(self, o: Vec3) -> Vec3 { Vec3(self.x - o.x, self.y - o.y, self.z - o.z) }
}

impl Mul for Vec3 {
    fn mul(self, k: f64) -> Vec3 { Vec3(self.x * k, self.y * k, self.z * k) }
}

impl Vec3 {
    fn zero() -> Vec3 { Vec3(0.0, 0.0, 0.0) }
    fn dot(self, o: Vec3) -> f64 { self.x * o.x + self.y * o.y + self.z * o.z }
    fn norm(self) -> f64 { sqrt(self.dot(self)) }
}

struct Body { pos: Vec3, vel: Vec3, mass: f64 }

fn step(bodies: mut [Body], dt: f64) {
    for i in 0..bodies.len {
        let mut acc = Vec3.zero()
        for j in 0..bodies.len where j != i {
            let d = bodies[j].pos - bodies[i].pos
            acc += d * (G * bodies[j].mass / d.norm()^3)
        }
        bodies[i].vel += acc * dt
    }
    for b in mut bodies { b.pos += b.vel * dt }
}

fn energy(bodies: [Body]) -> f64 {
    let mut e = 0.0
    for b in bodies {
        e += 0.5 * b.mass * b.vel.dot(b.vel)
    }
    e
}

fn main() {
    let mut bodies = vec[
        Body(Vec3(0.0, 0.0, 0.0), Vec3.zero(), 1.0e10),
        Body(Vec3(1.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0), 1.0)
    ]
    for t in 0..1000 {
        step(mut bodies, 0.01)
    }
    print("energy = {energy(bodies)}")
}
