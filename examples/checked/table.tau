// Printing a table with format specs: width, alignment, precision, zero padding, hexadecimal.

struct Planet { name: str, mass: f64, radius_km: f64, moons: i64 }

fn main() {
    let planets = [
        Planet("Mercury", 3.301e23, 2439.7, 0),
        Planet("Earth", 5.972e24, 6371.0, 1),
        Planet("Jupiter", 1.898e27, 69911.0, 95),
    ]
    print("{"planet":<10} {"mass (kg)":>12} {"radius":>10} {"moons":>5}")
    print("{"":-<10} {"":->12} {"":->10} {"":->5}")
    for p in planets {
        print("{p.name:<10} {p.mass:>12.3e} {p.radius_km:>10.1} {p.moons:>5}")
    }

    let g = 6.674e-11
    print("g = {g:e}   g = {g:.2E}")
    for i in 0..4 {
        print("{i:02} {i * 255:#06x} {i * 255:#b}")
    }
    print("{3.14159265:+.3} {-7:+} {1.0 / 3.0:.10} {0.5:.0} {1.5:.0}")
}
