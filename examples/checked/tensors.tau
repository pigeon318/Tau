// Building tensors from data and summarising them.

fn main() {
    // from data
    let signal = Tensor<f64, [_]>.from([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
    let mean = signal.mean()
    let deviations = signal.map(|x| (x - mean) ^ 2)
    let variance = deviations.mean()
    print("mean = {mean}, standard deviation = {sqrt(variance)}")
    print("range = {signal.min()} to {signal.max()}, {signal.shape()[0]} samples")

    // a table of values of a function
    let xs = Tensor<f64, [_]>.linspace(0.0, 1.0, 5)
    let ys = xs.map(|x| x * x)
    print("x  = {xs}")
    print("x^2 = {ys}")
    print("integral of x^2 on [0, 1] by the trapezoid rule = {(ys.sum() - 0.5 * (ys.min() + ys.max())) * 0.25}")

    // matrices
    let a = Tensor<f64, [_, _]>.from_rows(vec[vec[1.0, 2.0], vec[3.0, 4.0]])
    let id = Tensor<f64, [_, _]>.eye(2)
    print(a @ id)
    print(a.transpose())
    print(a.reshape(4))
    print(Tensor<f64, [_, _]>.full(0.5, 2, 3))
}
