// Tensors: constructors, matrix product, elementwise ops, indexing.

use math.linalg

fn main() {
    let a = Tensor<f64, [3, 3]>.zeros()
    let b = Tensor<f64, [_, _]>.random(3, 3)
    let c = a @ b
    let d = c + b
    let e = d * 2.0
    let v = Tensor<f64, [_]>.ones(3)
    let w = b @ v
    let x = e[0, 1]
    print(trace(d))
    print(x)
    // eigenvalues need a symmetric matrix
    let sym = d + linalg.transpose(d)
    let (vals, vecs) = linalg.eig(sym)
    print(vals)
}
