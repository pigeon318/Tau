// Enums, pattern matching, Option, and generics.

enum Shape {
    Circle(f64)
    Rect(f64, f64)
    Empty
}

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => PI * r^2
        Rect(w, h) => w * h
        Empty => 0.0
    }
}

fn name(s: Shape) -> str {
    match s {
        Circle(_) => "circle"
        Rect(w, h) if w == h => "square"
        Rect(_, _) => "rectangle"
        Empty => "nothing"
    }
}

fn first_big(xs: [f64], limit: f64) -> Option<f64> {
    for x in xs {
        if x > limit {
            return Some(x)
        }
    }
    None
}

struct Pair<A, B> { first: A, second: B }

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
    Pair(p.second, p.first)
}

fn describe(o: Option<f64>) -> str {
    match o {
        Some(x) if x > 10.0 => "big"
        Some(_) => "small"
        None => "none"
    }
}

fn main() {
    let shapes = [Circle(1.0), Rect(2.0, 3.0), Empty]
    let mut total = 0.0
    for s in shapes { total += area(s) }
    print("total area {total}")
    let p = swap(Pair(1, "one"))
    print(p.first)
    print(describe(first_big([1.0, 20.0], 10.0)))
    print(name(Rect(2.0, 2.0)))
}
