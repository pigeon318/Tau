fn collatz(n: i64) -> i64 {
    let mut x = n
    let mut steps = 0
    while x != 1 {
        if x % 2 == 0 { x = x / 2 } else { x = 3 * x + 1 }
        steps += 1
    }
    steps
}

fn gcd(a: u64, b: u64) -> u64 { if b == 0 { a } else { gcd(b, a % b) } }

fn main() {
    let mut best = 0
    let mut arg = 1
    for n in 1..300 {
        let s = collatz(n)
        if s > best {
            best = s
            arg = n
        }
    }
    print("{arg} {best}")
    print(gcd(1071, 462))
    let x: i32 = 46340
    print(x * x)
    let y: u8 = 200
    print(y + 50)
    print(2 ^ 20)
    print(7 / 2)
    print(-7 / 2)
    print(7 % 3)
    print(1 << 12)
    print(255u8 as i8)
    print(3.7 as i32)
    print(1.0 / 3.0)
    print(sqrt(2.0) * sqrt(2.0))
    print(100000 * 100000)
}
