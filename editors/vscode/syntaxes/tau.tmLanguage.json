{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tau",
  "scopeName": "source.tau",
  "fileTypes": [
    "tau"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tau",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.tau",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.tau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.tau"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.tau",
      "begin": "(#)(\\[)",
      "end": "\\]",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.tau"
        },
        "2": {
          "name": "punctuation.brackets.attribute.tau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.brackets.attribute.tau"
        }
      },
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "entity.other.attribute-name.tau"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "match": "[(),=]",
          "name": "punctuation.separator.tau"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tau",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tau"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.brace.tau"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "escapes": {
      "match": "\\\\(?:[nrt0\\\\\"'{}]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})",
      "name": "constant.character.escape.tau"
    },
    "interpolation": {
      "name": "meta.interpolation.tau",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.tau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.tau"
        }
      },
      "contentName": "meta.embedded.expression.tau",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "match": "(:)([^{}\"':|()\\[\\]\\s]{0,24})(?=\\})",
          "captures": {
            "1": {
              "name": "punctuation.separator.format.tau"
            },
            "2": {
              "name": "constant.other.format-spec.tau"
            }
          }
        },
        {
          "include": "#code"
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "#code"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.char.tau",
      "match": "'(?:[^'\\\\\\n]|\\\\(?:[nrt0\\\\\"'{}]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\}))'",
      "captures": {}
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tau",
          "match": "\\b0x[0-9a-fA-F_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.binary.tau",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.octal.tau",
          "match": "\\b0o[0-7_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.float.tau",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)(?:f32|f64|i)?\\b"
        },
        {
          "name": "constant.numeric.integer.tau",
          "match": "\\b\\d[\\d_]*(?:[iu](?:8|16|32|64|128|size)|f32|f64|i)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.tau"
            },
            "2": {
              "name": "entity.name.function.tau"
            }
          }
        },
        {
          "match": "\\b(struct|enum|trait|cluster)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.tau"
            },
            "2": {
              "name": "entity.name.type.$1.tau"
            }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.alias.tau"
            },
            "2": {
              "name": "entity.name.type.alias.tau"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.const.tau"
            },
            "2": {
              "name": "variable.other.constant.tau"
            }
          }
        },
        {
          "match": "\\b(use)\\b",
          "name": "keyword.other.use.tau"
        },
        {
          "match": "\\b(impl)\\b",
          "name": "storage.type.impl.tau"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tau",
          "match": "\\b(if|else|match|for|while|loop|break|continue|return|in)\\b"
        },
        {
          "name": "keyword.control.parallel.tau",
          "match": "\\b(par|spawn|on)\\b(?=\\s*[{(A-Za-z_])"
        },
        {
          "name": "storage.modifier.tau",
          "match": "\\b(pub|unsafe|own)\\b"
        },
        {
          "name": "storage.modifier.mut.tau",
          "match": "\\bmut\\b"
        },
        {
          "name": "storage.type.let.tau",
          "match": "\\blet\\b"
        },
        {
          "name": "keyword.operator.cast.tau",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.other.where.tau",
          "match": "\\bwhere\\b"
        },
        {
          "name": "constant.language.boolean.tau",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.tau",
          "match": "\\b(self|Self)\\b"
        },
        {
          "name": "support.constant.tau",
          "match": "\\b(PI|TAU)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.tau",
          "match": "\\b(?:[iu](?:8|16|32|64|128|size)|f32|f64|c64|c128|bool|char|str)\\b"
        },
        {
          "name": "support.type.builtin.tau",
          "match": "\\b(?:Vec|String|Option|Result|Map|Tensor|Task|Range|Ptr|Cluster|IoError|TaskPanicked|Complex)\\b"
        },
        {
          "name": "support.class.enum-variant.tau",
          "match": "\\b(?:Some|None|Ok|Err)\\b"
        },
        {
          "name": "entity.name.type.tau",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.tau",
          "match": "\\b(?:print|assert|assert_eq|panic|sqrt|sin|cos|tan|asin|acos|atan|atan2|exp|ln|log10|abs|floor|ceil|round|min|max|sum|vec|tensor|det|inv|eig|trace|transpose|fft|ifft|read_line|alloc|free)\\b(?=\\s*[(<\\[])"
        },
        {
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)(?=\\s*[(<])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.tau"
            },
            "2": {
              "name": "entity.name.function.method.tau"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^<>()]*>)?\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tau"
            }
          }
        },
        {
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*|\\d+)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.tau"
            },
            "2": {
              "name": "variable.other.property.tau"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.tau",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.tau",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.matmul.tau",
          "match": "@"
        },
        {
          "name": "keyword.operator.assignment.compound.tau",
          "match": "(?:\\+|-|\\*|/|%|\\^\\^|\\^|&|\\||<<|>>)="
        },
        {
          "name": "keyword.operator.comparison.tau",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tau",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.tau",
          "match": "="
        },
        {
          "name": "keyword.operator.power.tau",
          "match": "\\^(?!\\^)"
        },
        {
          "name": "keyword.operator.arithmetic.tau",
          "match": "\\^\\^|\\+|-|\\*|/|%|&|\\||~|<<|>>"
        },
        {
          "name": "keyword.operator.try.tau",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.type.tau",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.tau",
          "match": ","
        },
        {
          "name": "punctuation.accessor.tau",
          "match": "\\."
        },
        {
          "name": "punctuation.brackets.tau",
          "match": "[\\[\\](){}]"
        }
      ]
    }
  }
}
