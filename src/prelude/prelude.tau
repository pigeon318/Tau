// The prelude: names visible in every module. Functions without a body are
// implemented by the runtime (builtins); this file only declares their types.

// ---- core types -------------------------------------------------------------

pub struct Vec<T> { pub len: usize }
pub struct String { pub len: usize }
pub struct Range<T> { pub start: T, pub end: T }
pub struct Ptr<T> {}
pub struct Box<T> {}
pub struct Shared<T> {}
pub struct Mutex<T> {}
pub struct Task<T> {}
pub struct Cluster {}
pub struct IoError { pub message: String }
pub struct TaskPanicked {}

pub enum Option<T> {
    Some(T)
    None
}

pub enum Result<T, E> {
    Ok(T)
    Err(E)
}

// ---- traits satisfied by rules for built-in types ---------------------------

#[builtin_trait] pub trait Num {}
#[builtin_trait] pub trait Int {}
#[builtin_trait] pub trait Float {}
#[builtin_trait] pub trait Copy {}
#[builtin_trait] pub trait Clone { fn clone(self) -> Self }
#[builtin_trait] pub trait Eq { fn eq(self, o: Self) -> bool }
#[builtin_trait] pub trait Ord { fn lt(self, o: Self) -> bool }
#[builtin_trait] pub trait Display { fn fmt(self) -> String }

// ---- operator traits (impls need matching names and arity, not signatures) --

#[op] pub trait Add { fn add(self, o: Self) -> Self }
#[op] pub trait Sub { fn sub(self, o: Self) -> Self }
#[op] pub trait Mul { fn mul(self, o: Self) -> Self }
#[op] pub trait Div { fn div(self, o: Self) -> Self }
#[op] pub trait Rem { fn rem(self, o: Self) -> Self }
#[op] pub trait Pow { fn pow(self, o: Self) -> Self }
#[op] pub trait MatMul { fn matmul(self, o: Self) -> Self }
#[op] pub trait BitAnd { fn bitand(self, o: Self) -> Self }
#[op] pub trait BitOr { fn bitor(self, o: Self) -> Self }
#[op] pub trait BitXor { fn bitxor(self, o: Self) -> Self }
#[op] pub trait Shl { fn shl(self, o: Self) -> Self }
#[op] pub trait Shr { fn shr(self, o: Self) -> Self }
#[op] pub trait Neg { fn neg(self) -> Self }
#[op] pub trait Index { fn index(self, i: Self) -> Self }

// ---- constants and functions ------------------------------------------------

pub const PI: f64 = 3.141592653589793
pub const TAU: f64 = 6.283185307179586
pub const E: f64 = 2.718281828459045

pub fn sqrt<T: Float>(x: T) -> T
pub fn sin<T: Float>(x: T) -> T
pub fn cos<T: Float>(x: T) -> T
pub fn tan<T: Float>(x: T) -> T
pub fn asin<T: Float>(x: T) -> T
pub fn acos<T: Float>(x: T) -> T
pub fn atan<T: Float>(x: T) -> T
pub fn atan2<T: Float>(y: T, x: T) -> T
pub fn exp<T: Float>(x: T) -> T
pub fn ln<T: Float>(x: T) -> T
pub fn log10<T: Float>(x: T) -> T
pub fn floor<T: Float>(x: T) -> T
pub fn ceil<T: Float>(x: T) -> T
pub fn round<T: Float>(x: T) -> T
pub fn abs<T: Num>(x: T) -> T
pub fn min<T: Ord>(a: T, b: T) -> T
pub fn max<T: Ord>(a: T, b: T) -> T
// The character with this code, or `None` if it is not one (surrogates and numbers above 0x10FFFF).
pub fn char_from_u32(n: u32) -> Option<char>
pub fn zero<T: Num>() -> T
pub fn one<T: Num>() -> T
pub fn sum<T: Num>(xs: [T]) -> T
pub fn trace<T: Num>(a: Tensor<T, [_, _]>) -> T

pub fn print<T: Display>(x: T)
pub fn assert(cond: bool)
pub fn assert_eq<T: Eq + Display>(a: T, b: T)
pub fn panic(msg: str) -> Never

pub fn par_chunks<T>(xs: mut [T], size: usize) -> Vec<[T]>
pub unsafe fn alloc<T>(n: usize) -> Ptr<T>

// ---- methods on built-in types ----------------------------------------------

impl<T> Vec<T> {
    pub fn new() -> Vec<T>
    pub fn push(mut self, x: T)
    pub fn pop(mut self) -> Option<T>
    pub unsafe fn from_raw(p: Ptr<T>, n: usize) -> Vec<T>
}

impl<T> Box<T> {
    pub fn new(own x: T) -> Box<T>
    pub fn take(own self) -> T
}

// `Shared<T>`: one value with several owners (reference counted, atomically, so a handle can be moved into
// a task). `s.clone()` makes another handle to the same value; the value is read through any of them, never
// changed. The value is dropped with its last handle.
impl<T> Shared<T> {
    pub fn new(own x: T) -> Shared<T>
}

// `Mutex<T>`: a value that tasks change one at a time. Usually `Shared<Mutex<T>>`.
impl<T> Mutex<T> {
    pub fn new(own x: T) -> Mutex<T>
    pub fn set(self, own x: T)
    pub fn update(self, f: fn(T) -> T)
    pub fn with<U>(self, f: fn(T) -> U) -> U
    pub fn into_inner(own self) -> T
}
impl<T: Clone> Mutex<T> {
    pub fn get(self) -> T
}

impl<T> [T] {
    pub fn swap(mut self, i: usize, j: usize)
    pub fn map<U>(self, f: fn(T) -> U) -> Vec<U>
    pub fn filter(self, f: fn(T) -> bool) -> Vec<T>
    pub fn to_vec(self) -> Vec<T>
    pub fn is_empty(self) -> bool
}

impl<T: Num> [T] {
    pub fn sum(self) -> T
}

impl<T> Task<T> {
    pub fn join(own self) -> Result<T, TaskPanicked>
}

impl<T: Copy> Copy for Option<T> {}
impl<T: Copy, E: Copy> Copy for Result<T, E> {}
impl<T: Copy> Copy for Range<T> {}

impl<T> Index for Ptr<T> {
    pub fn index(self, i: usize) -> T
}

impl String {
    pub fn new() -> String
    pub fn from(s: str) -> String
    pub fn push_str(mut self, s: str)
    pub fn push(mut self, c: char)
}

impl str {
    // The byte at position `i` (panics past the end).
    pub fn byte_at(self, i: usize) -> u8
    // `"12".parse_i64()`: an optional sign and decimal digits, nothing else (no spaces, no `_`).
    pub fn parse_i64(self) -> Result<i64, String>
    // `"2.5e3".parse_f64()`: an optional sign, digits with an optional `.`, an optional exponent. (No `inf` or `nan`.)
    pub fn parse_f64(self) -> Result<f64, String>
    pub fn to_string(self) -> String
    pub fn split_whitespace(self) -> Vec<str>
    pub fn lowercase(self) -> String
    pub fn uppercase(self) -> String
}

// ---- iterators ---------------------------------------------------------------
//
// An iterator is anything with a `next` method: each call gives the next item, or `None` when
// there are no more. The adapters below are ordinary Tau structs, so a chain such as
// `v.iter().filter(|x| x > 0).map(|x| x * x).sum()` makes no vectors and no copies of `v`:
// each item travels through the whole chain before the next one starts.

pub trait Iterator<T> {
    fn next(mut self) -> Option<T>

    fn map<U>(own self, own f: fn(T) -> U) -> MapIter<Self, T, U> { MapIter(self, f) }
    fn filter(own self, own f: fn(T) -> bool) -> FilterIter<Self, T> { FilterIter(self, f) }
    fn enumerate(own self) -> EnumerateIter<Self, T> { EnumerateIter(self, 0) }
    fn zip<U, J: Iterator<U>>(own self, own other: J) -> ZipIter<Self, J, T, U> { ZipIter(self, other) }
    fn take(own self, n: usize) -> TakeIter<Self, T> { TakeIter(self, n) }
    fn skip(own self, n: usize) -> SkipIter<Self, T> { SkipIter(self, n) }
    fn step_by(own self, n: usize) -> StepIter<Self, T> {
        if n == 0 { panic("step_by: the step must not be 0") }
        StepIter(self, n, false)
    }
    fn chain<J: Iterator<T>>(own self, own other: J) -> ChainIter<Self, J, T> { ChainIter(self, other, false) }
    fn take_while(own self, own f: fn(T) -> bool) -> TakeWhileIter<Self, T> { TakeWhileIter(self, f, false) }
    fn skip_while(own self, own f: fn(T) -> bool) -> SkipWhileIter<Self, T> { SkipWhileIter(self, f, false) }

    fn collect(own self) -> Vec<T> {
        let mut it = self
        let mut v = Vec.new()
        loop {
            match it.next() {
                Some(x) => v.push(x)
                None => break
            }
        }
        v
    }
    fn count(own self) -> usize {
        let mut it = self
        let mut n = 0
        loop {
            match it.next() {
                Some(_) => n += 1
                None => break
            }
        }
        n
    }
    fn fold<A>(own self, own init: A, f: fn(A, T) -> A) -> A {
        let mut it = self
        let mut acc = init
        loop {
            match it.next() {
                Some(x) => acc = f(acc, x)
                None => break
            }
        }
        acc
    }
    fn for_each(own self, f: fn(T)) {
        let mut it = self
        loop {
            match it.next() {
                Some(x) => f(x)
                None => break
            }
        }
    }
    fn any(own self, f: fn(T) -> bool) -> bool {
        let mut it = self
        loop {
            match it.next() {
                Some(x) => { if f(x) { return true } }
                None => return false
            }
        }
    }
    fn all(own self, f: fn(T) -> bool) -> bool {
        let mut it = self
        loop {
            match it.next() {
                Some(x) => { if !f(x) { return false } }
                None => return true
            }
        }
    }
    fn find(own self, f: fn(T) -> bool) -> Option<T> {
        let mut it = self
        loop {
            match it.next() {
                Some(x) => { if f(x) { return Some(x) } }
                None => return None
            }
        }
    }
    fn position(own self, f: fn(T) -> bool) -> Option<usize> {
        let mut it = self
        let mut i = 0
        loop {
            match it.next() {
                Some(x) => {
                    if f(x) { return Some(i) }
                    i += 1
                }
                None => return None
            }
        }
    }
    fn last(own self) -> Option<T> {
        let mut it = self
        let mut r = None
        loop {
            match it.next() {
                Some(x) => r = Some(x)
                None => break
            }
        }
        r
    }
    fn nth(own self, n: usize) -> Option<T> {
        let mut it = self
        let mut i = 0
        loop {
            match it.next() {
                Some(x) => {
                    if i == n { return Some(x) }
                    i += 1
                }
                None => return None
            }
        }
    }
}

// `sum`, `product`, `min` and `max` need the items to be numbers (or ordered).
pub trait IterNum<T: Num> {
    fn sum(own self) -> T
    fn product(own self) -> T
}
impl<I: Iterator<T>, T: Num> IterNum<T> for I {
    fn sum(own self) -> T {
        let mut it = self
        let mut acc: T = zero()
        loop {
            match it.next() {
                Some(x) => acc = acc + x
                None => break
            }
        }
        acc
    }
    fn product(own self) -> T {
        let mut it = self
        let mut acc: T = one()
        loop {
            match it.next() {
                Some(x) => acc = acc * x
                None => break
            }
        }
        acc
    }
}
pub trait IterOrd<T: Ord> {
    fn min(own self) -> Option<T>
    fn max(own self) -> Option<T>
}
impl<I: Iterator<T>, T: Ord> IterOrd<T> for I {
    fn min(own self) -> Option<T> {
        let mut it = self
        let mut best = it.next()
        loop {
            match it.next() {
                Some(x) => {
                    match best {
                        Some(b) => { if x < b { best = Some(x) } }
                        None => {}
                    }
                }
                None => break
            }
        }
        best
    }
    fn max(own self) -> Option<T> {
        let mut it = self
        let mut best = it.next()
        loop {
            match it.next() {
                Some(x) => {
                    match best {
                        Some(b) => { if !(x < b) { best = Some(x) } }
                        None => {}
                    }
                }
                None => break
            }
        }
        best
    }
}

// ---- adapters

pub struct MapIter<I, T, U> { inner: I, f: fn(T) -> U }
impl<I: Iterator<T>, T, U> Iterator<U> for MapIter<I, T, U> {
    fn next(mut self) -> Option<U> {
        match self.inner.next() {
            Some(x) => Some((self.f)(x))
            None => None
        }
    }
}

pub struct FilterIter<I, T> { inner: I, f: fn(T) -> bool }
impl<I: Iterator<T>, T> Iterator<T> for FilterIter<I, T> {
    fn next(mut self) -> Option<T> {
        loop {
            match self.inner.next() {
                Some(x) => { if (self.f)(x) { return Some(x) } }
                None => return None
            }
        }
    }
}

pub struct EnumerateIter<I, T> { inner: I, i: usize }
impl<I: Iterator<T>, T> Iterator<(usize, T)> for EnumerateIter<I, T> {
    fn next(mut self) -> Option<(usize, T)> {
        match self.inner.next() {
            Some(x) => {
                let i = self.i
                self.i += 1
                Some((i, x))
            }
            None => None
        }
    }
}

pub struct ZipIter<A, B, T, U> { a: A, b: B }
impl<A: Iterator<T>, B: Iterator<U>, T, U> Iterator<(T, U)> for ZipIter<A, B, T, U> {
    fn next(mut self) -> Option<(T, U)> {
        match self.a.next() {
            Some(x) => {
                match self.b.next() {
                    Some(y) => Some((x, y))
                    None => None
                }
            }
            None => None
        }
    }
}

pub struct TakeIter<I, T> { inner: I, left: usize }
impl<I: Iterator<T>, T> Iterator<T> for TakeIter<I, T> {
    fn next(mut self) -> Option<T> {
        if self.left == 0 { return None }
        self.left -= 1
        self.inner.next()
    }
}

pub struct SkipIter<I, T> { inner: I, n: usize }
impl<I: Iterator<T>, T> Iterator<T> for SkipIter<I, T> {
    fn next(mut self) -> Option<T> {
        while self.n > 0 {
            self.n -= 1
            match self.inner.next() {
                Some(_) => {}
                None => return None
            }
        }
        self.inner.next()
    }
}

pub struct StepIter<I, T> { inner: I, step: usize, started: bool }
impl<I: Iterator<T>, T> Iterator<T> for StepIter<I, T> {
    fn next(mut self) -> Option<T> {
        if !self.started {
            self.started = true
            return self.inner.next()
        }
        let mut k = self.step - 1
        while k > 0 {
            k -= 1
            match self.inner.next() {
                Some(_) => {}
                None => return None
            }
        }
        self.inner.next()
    }
}

pub struct ChainIter<A, B, T> { a: A, b: B, first_done: bool }
impl<A: Iterator<T>, B: Iterator<T>, T> Iterator<T> for ChainIter<A, B, T> {
    fn next(mut self) -> Option<T> {
        if !self.first_done {
            match self.a.next() {
                Some(x) => return Some(x)
                None => self.first_done = true
            }
        }
        self.b.next()
    }
}

pub struct TakeWhileIter<I, T> { inner: I, f: fn(T) -> bool, done: bool }
impl<I: Iterator<T>, T> Iterator<T> for TakeWhileIter<I, T> {
    fn next(mut self) -> Option<T> {
        if self.done { return None }
        match self.inner.next() {
            Some(x) => {
                if (self.f)(x) { return Some(x) }
                self.done = true
                None
            }
            None => None
        }
    }
}

pub struct SkipWhileIter<I, T> { inner: I, f: fn(T) -> bool, started: bool }
impl<I: Iterator<T>, T> Iterator<T> for SkipWhileIter<I, T> {
    fn next(mut self) -> Option<T> {
        if self.started { return self.inner.next() }
        loop {
            match self.inner.next() {
                Some(x) => {
                    if !(self.f)(x) {
                        self.started = true
                        return Some(x)
                    }
                }
                None => return None
            }
        }
    }
}

// ---- sources

// The items of an array, a vector or a slice, copied out one at a time (`for x in v` borrows
// them instead).
pub struct SliceIter<T> { xs: [T], i: usize }
impl<T: Clone> Iterator<T> for SliceIter<T> {
    fn next(mut self) -> Option<T> {
        if self.i < self.xs.len {
            let x = self.xs[self.i].clone()
            self.i += 1
            Some(x)
        } else {
            None
        }
    }
}

// The numbers of a range: `(0..n).iter()`. (`for i in 0..n` does not need this.)
pub struct RangeIter<T> { cur: T, end: T }
impl<T: Int + Ord + Num + Copy> Iterator<T> for RangeIter<T> {
    fn next(mut self) -> Option<T> {
        if self.cur < self.end {
            let x = self.cur
            self.cur = self.cur + one()
            Some(x)
        } else {
            None
        }
    }
}
impl<T: Int + Ord + Num + Copy> Range<T> {
    pub fn iter(self) -> RangeIter<T> { RangeIter(self.start, self.end) }
}
impl<T> [T] {
    pub fn iter(self) -> SliceIter<T> { SliceIter(self, 0) }
}

// ---- vectors and slices (written in Tau on top of `push`, `pop`, `swap`, indexing and `len`) --------------

impl<T> Vec<T> {
    // Put `x` at position `i` (`0 ..= len`), moving the later elements up by one.
    pub fn insert(mut self, i: usize, own x: T) {
        if i > self.len { panic("insert: the index is greater than the length") }
        self.push(x)
        let mut k = self.len - 1
        while k > i {
            self.swap(k, k - 1)
            k -= 1
        }
    }
    // Take out the element at `i`, moving the later elements down by one.
    pub fn remove(mut self, i: usize) -> T {
        if i >= self.len { panic("remove: the index is not less than the length") }
        let mut k = i
        while k + 1 < self.len {
            self.swap(k, k + 1)
            k += 1
        }
        match self.pop() {
            Some(x) => x
            None => panic("remove: empty vector")
        }
    }
    // Take out the element at `i` by putting the last one in its place (fast, changes the order).
    pub fn swap_remove(mut self, i: usize) -> T {
        if i >= self.len { panic("swap_remove: the index is not less than the length") }
        let last = self.len - 1
        self.swap(i, last)
        match self.pop() {
            Some(x) => x
            None => panic("swap_remove: empty vector")
        }
    }
    // Keep the first `n` elements.
    pub fn truncate(mut self, n: usize) {
        while self.len > n { self.pop() }
    }
    pub fn clear(mut self) {
        while self.len > 0 { self.pop() }
    }
    // Keep only the elements for which `keep` says true (their order is kept).
    pub fn retain(mut self, keep: fn(T) -> bool) {
        let mut w = 0
        let mut r = 0
        let n = self.len
        while r < n {
            if keep(self[r]) {
                self.swap(w, r)
                w += 1
            }
            r += 1
        }
        self.truncate(w)
    }
}

impl<T: Clone> Vec<T> {
    // Add a copy of every element of `other` at the end.
    pub fn extend(mut self, other: [T]) {
        let n = other.len
        let mut i = 0
        while i < n {
            self.push(other[i].clone())
            i += 1
        }
    }
}

impl<T> [T] {
    pub fn reverse(mut self) {
        let n = self.len
        let mut i = 0
        while i < n / 2 {
            self.swap(i, n - 1 - i)
            i += 1
        }
    }
    // Sort with `less(a, b)` (true when `a` goes before `b`). Heap sort: O(n log n), and equal elements may
    // change their relative order.
    pub fn sort_by(mut self, less: fn(T, T) -> bool) {
        let n = self.len
        if n < 2 { return }
        let mut start = n / 2
        while start > 0 {
            start -= 1
            sift_down(mut self, start, n, less)
        }
        let mut end = n
        while end > 1 {
            end -= 1
            self.swap(0, end)
            sift_down(mut self, 0, end, less)
        }
    }
}

impl<T: Clone> [T] {
    pub fn first(self) -> Option<T> {
        if self.len == 0 { None } else { Some(self[0].clone()) }
    }
    pub fn last(self) -> Option<T> {
        if self.len == 0 { None } else { Some(self[self.len - 1].clone()) }
    }
    // The element at `i`, or `None` past the end.
    pub fn get(self, i: usize) -> Option<T> {
        if i < self.len { Some(self[i].clone()) } else { None }
    }
    pub fn fill(mut self, x: T) {
        let n = self.len
        let mut i = 0
        while i < n {
            self[i] = x.clone()
            i += 1
        }
    }
}

impl<T: Ord> [T] {
    pub fn sort(mut self) {
        self.sort_by(|a, b| a < b)
    }
    pub fn is_sorted(self) -> bool {
        let mut i = 1
        while i < self.len {
            if self[i] < self[i - 1] { return false }
            i += 1
        }
        true
    }
}

impl<T: Eq> [T] {
    pub fn contains(self, x: T) -> bool {
        let mut i = 0
        while i < self.len {
            if self[i] == x { return true }
            i += 1
        }
        false
    }
    // The position of the first element equal to `x`.
    pub fn position_of(self, x: T) -> Option<usize> {
        let mut i = 0
        while i < self.len {
            if self[i] == x { return Some(i) }
            i += 1
        }
        None
    }
}

fn sift_down<T>(v: mut [T], root: usize, end: usize, less: fn(T, T) -> bool) {
    let mut r = root
    loop {
        let mut child = 2 * r + 1
        if child >= end { return }
        if child + 1 < end && less(v[child], v[child + 1]) { child += 1 }
        if less(v[r], v[child]) {
            v.swap(r, child)
            r = child
        } else {
            return
        }
    }
}

// ---- strings (written in Tau on top of `byte_at`, `s[a..b]`, `char_from_u32` and `push`) -----------------------
// Positions are byte positions in the UTF-8 text. `s[a..b]` panics if a position is not on a character boundary.

fn is_space_byte(b: u8) -> bool {
    b == 32 || (b >= 9 && b <= 13)
}

fn matches_at(s: str, i: usize, p: str) -> bool {
    if i + p.len > s.len { return false }
    let mut j = 0
    while j < p.len {
        if s.byte_at(i + j) != p.byte_at(j) { return false }
        j += 1
    }
    true
}

impl str {
    pub fn is_empty(self) -> bool { self.len == 0 }
    pub fn starts_with(self, p: str) -> bool { matches_at(self, 0, p) }
    pub fn ends_with(self, p: str) -> bool {
        if p.len > self.len { return false }
        matches_at(self, self.len - p.len, p)
    }
    // The byte position of the first occurrence of `p`.
    pub fn find(self, p: str) -> Option<usize> {
        let mut i = 0
        while i + p.len <= self.len {
            if matches_at(self, i, p) { return Some(i) }
            i += 1
        }
        None
    }
    pub fn contains(self, p: str) -> bool {
        match self.find(p) {
            Some(_) => true
            None => false
        }
    }
    // Without white space (space, tab, newline, ...) at the start and at the end.
    pub fn trim_start(self) -> str {
        let mut i = 0
        while i < self.len && is_space_byte(self.byte_at(i)) { i += 1 }
        self[i..]
    }
    pub fn trim_end(self) -> str {
        let mut j = self.len
        while j > 0 && is_space_byte(self.byte_at(j - 1)) { j -= 1 }
        self[..j]
    }
    pub fn trim(self) -> str { self.trim_start().trim_end() }
    // The parts between the occurrences of `sep` (which must not be empty). Adjacent separators give empty parts.
    pub fn split(self, sep: str) -> Vec<str> {
        if sep.len == 0 { panic("split: the separator is empty") }
        let mut out: Vec<str> = Vec.new()
        let mut start = 0
        let mut i = 0
        while i + sep.len <= self.len {
            if matches_at(self, i, sep) {
                out.push(self[start..i])
                i += sep.len
                start = i
            } else {
                i += 1
            }
        }
        out.push(self[start..])
        out
    }
    // The lines of the text, without their line ends (`\n` or `\r\n`); a final line end does not start another line.
    pub fn lines(self) -> Vec<str> {
        let mut out: Vec<str> = Vec.new()
        let mut start = 0
        let mut i = 0
        while i < self.len {
            if self.byte_at(i) == 10 {
                let mut end = i
                if end > start && self.byte_at(end - 1) == 13 { end -= 1 }
                out.push(self[start..end])
                start = i + 1
            }
            i += 1
        }
        if start < self.len { out.push(self[start..]) }
        out
    }
    // A copy with every occurrence of `from` (not empty) replaced by `to`.
    pub fn replace(self, from: str, to: str) -> String {
        if from.len == 0 { panic("replace: the text to replace is empty") }
        let mut out = String.new()
        let mut start = 0
        let mut i = 0
        while i + from.len <= self.len {
            if matches_at(self, i, from) {
                out.push_str(self[start..i])
                out.push_str(to)
                i += from.len
                start = i
            } else {
                i += 1
            }
        }
        out.push_str(self[start..])
        out
    }
    pub fn repeat(self, n: usize) -> String {
        let mut out = String.new()
        let mut k = 0
        while k < n {
            out.push_str(self)
            k += 1
        }
        out
    }
    // The characters (Unicode code points) of the text.
    pub fn chars(self) -> Vec<char> {
        let mut out: Vec<char> = Vec.new()
        let mut i = 0
        while i < self.len {
            let b = self.byte_at(i) as u32
            let mut code = b
            let mut n = 1
            if b >= 240 {
                code = ((b & 7) << 18) | ((self.byte_at(i + 1) as u32 & 63) << 12) | ((self.byte_at(i + 2) as u32 & 63) << 6) | (self.byte_at(i + 3) as u32 & 63)
                n = 4
            } else if b >= 224 {
                code = ((b & 15) << 12) | ((self.byte_at(i + 1) as u32 & 63) << 6) | (self.byte_at(i + 2) as u32 & 63)
                n = 3
            } else if b >= 192 {
                code = ((b & 31) << 6) | (self.byte_at(i + 1) as u32 & 63)
                n = 2
            }
            match char_from_u32(code) {
                Some(c) => out.push(c)
                None => panic("invalid character in text")
            }
            i += n
        }
        out
    }
    pub fn char_count(self) -> usize { self.chars().len }
}

impl String {
    pub fn is_empty(self) -> bool { self.len == 0 }
    pub fn clear(mut self) {
        let fresh = String.new()
        self = fresh
    }
}

// The text of the pieces with `sep` between them.
impl [String] {
    pub fn join(self, sep: str) -> String {
        let mut out = String.new()
        let mut i = 0
        while i < self.len {
            if i > 0 { out.push_str(sep) }
            out.push_str(self[i])
            i += 1
        }
        out
    }
}
impl [str] {
    pub fn join(self, sep: str) -> String {
        let mut out = String.new()
        let mut i = 0
        while i < self.len {
            if i > 0 { out.push_str(sep) }
            out.push_str(self[i])
            i += 1
        }
        out
    }
}

// Characters (ASCII rules: letters, digits and white space outside ASCII are not recognised).
impl char {
    pub fn is_digit(self) -> bool { self >= '0' && self <= '9' }
    pub fn is_uppercase(self) -> bool { self >= 'A' && self <= 'Z' }
    pub fn is_lowercase(self) -> bool { self >= 'a' && self <= 'z' }
    pub fn is_alphabetic(self) -> bool { self.is_uppercase() || self.is_lowercase() }
    pub fn is_alphanumeric(self) -> bool { self.is_alphabetic() || self.is_digit() }
    pub fn is_whitespace(self) -> bool { self == ' ' || (self >= '\t' && self <= '\r') }
    // The value of a decimal digit.
    pub fn to_digit(self) -> Option<i64> {
        if self.is_digit() { Some(self as i64 - '0' as i64) } else { None }
    }
}
